# Copy to .env next to compose.yaml, then `chmod 600 .env`.
# .env is ignored by Git. Never commit real passwords here.

# --- Host -------------------------------------------------------------------
# The HP's LAN address. Frigate's ports bind only to this address.
HP_LAN_IP=192.168.1.241
TZ=UTC

# Service state on the RAID0 logical drive (root LV, 100 GiB). Created by prepare-host.sh.
SERVICES_DATA_ROOT=/srv/services

# --- Relay Station (Telegram bot) ----------------------------------------------
# Absolute path of a clone of Noxy-HNR/ai-workspace on the HP. The image is built
# from its TelegramBot folder.
AI_WORKSPACE_DIR=/opt/ai-workspace
RELAY_PORT=9095
# Container user. prepare-host.sh gives this UID ownership of the data folder.
RELAY_UID=10001
RELAY_GID=10001
# The Telegram bot token and any LLM API key are NOT set here. Relay Station keeps
# them in its own database (bot.db), which the runbook copies from the PC, or you
# paste them in Settings in the console.

# --- Frigate (profile "nvr") ---------------------------------------------------------
FRIGATE_VERSION=0.16.1
# Recordings and snapshots. The default sits on the 100 GiB root LV, so keep
# retention short (see frigate/config.example.yml) or point this at a dedicated LV.
FRIGATE_MEDIA_DIR=/srv/services/frigate/media
FRIGATE_CPUS=4.0
FRIGATE_MEMORY=4g
FRIGATE_SHM_SIZE=256mb
# Camera RTSP credentials, substituted into config.yml as {FRIGATE_RTSP_USER}
# and {FRIGATE_RTSP_PASSWORD}. Leave blank until a camera is added.
FRIGATE_RTSP_USER=
FRIGATE_RTSP_PASSWORD=
